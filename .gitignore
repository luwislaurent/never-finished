* {
  box-sizing: border-box;
}

:root {
  font-family: 'Futura Local', 'Segoe UI', Helvetica, Arial, sans-serif;
  color: #f5f5f5;
  background: #000;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

html,
body,
#root {
  margin: 0;
  min-height: 100%;
  height: 100%;
  background: #000;
}

body {
  min-height: 100vh;
  background: #000;
  color: #f5f5f5;
}

button,
input {
  font: inherit;
}

.app-shell {
  position: relative;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 100vh;
  background: #000;
  padding: 2rem 2rem 1.5rem;
  overflow: hidden;
}

.walk-stage {
  position: relative;
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 540px;
  padding: 2rem 0 4rem;
}

.word-wrap {
  position: relative;
  z-index: 1;
  width: min(92vw, 1500px);
  text-align: center;
  pointer-events: none;
}

.walk-word {
  font-family: 'Futura Local', 'Arial Black', 'Segoe UI', sans-serif;
  font-size: clamp(7rem, 18vw, 30rem);
  font-weight: 900;
  line-height: 0.8;
  letter-spacing: -0.08em;
  text-transform: uppercase;
  color: #f3f3f3;
  user-select: none;
}

.route-svg {
  position: absolute;
  inset: 10% 0 14% 0;
  width: 100%;
  height: 80%;
  z-index: 2;
  pointer-events: none;
}

.route {
  fill: none;
  stroke-linecap: round;
  stroke-linejoin: round;
}

.route-base {
  stroke: rgba(255, 255, 255, 0.2);
  stroke-width: 2.5;
  stroke-dasharray: 1 12;
  transform: translateY(8px);
}

.route-active {
  stroke: rgba(255, 255, 255, 0.9);
  stroke-width: 2.5;
  stroke-dasharray: 1 12;
  filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.18));
  transform: translateY(8px);
}

.day-panel {
  position: absolute;
  left: 2rem;
  bottom: 7.5rem;
  z-index: 3;
  width: min(32rem, calc(100% - 4rem));
  padding: 1.2rem 1.3rem 1rem;
  background: rgba(255, 255, 255, 0.015);
  border: 1px solid rgba(255, 255, 255, 0.16);
  backdrop-filter: blur(4px);
}

.eyebrow {
  font-size: 0.68rem;
  letter-spacing: 0.28rem;
  color: rgba(255, 255, 255, 0.52);
  margin-bottom: 0.6rem;
}

.day-panel h2 {
  margin: 0;
  font-family: 'Futura Local', 'Arial Black', 'Segoe UI', sans-serif;
  font-size: clamp(1.05rem, 2vw, 1.8rem);
  font-weight: 700;
  letter-spacing: 0.02em;
  text-transform: uppercase;
  color: #f7f7f7;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  margin-top: 1.25rem;
}

.label {
  display: block;
  font-size: 0.63rem;
  letter-spacing: 0.18rem;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.5);
  margin-bottom: 0.28rem;
}

.stats-grid strong {
  display: block;
  font-size: 0.95rem;
  font-weight: 500;
  line-height: 1.4;
}

.notes-block {
  margin-top: 1.2rem;
  display: grid;
  gap: 1rem;
}

.note {
  padding-top: 0.75rem;
  border-top: 1px solid rgba(255, 255, 255, 0.16);
}

.note p {
  margin: 0.35rem 0 0;
  font-size: 0.96rem;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.6;
}

.timeline {
  position: relative;
  padding: 1.1rem 0 0.2rem;
}

.timeline-topline,
.timeline-bottomline {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.65rem;
  letter-spacing: 0.18rem;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.52);
}

.slider-shell {
  position: relative;
  margin: 1rem 0 0.8rem;
  height: 2.6rem;
}

.slider-shell input[type='range'] {
  -webkit-appearance: none;
  appearance: none;
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  background: transparent;
  z-index: 3;
  cursor: pointer;
}

.slider-shell input[type='range']::-webkit-slider-runnable-track {
  height: 1px;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 999px;
}

.slider-shell input[type='range']::-webkit-slider-thumb {
  -webkit-appearance: none;
  appearance: none;
  width: 16px;
  height: 16px;
  border-radius: 50%;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.6);
  margin-top: -7px;
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08);
}

.slider-shell input[type='range']::-moz-range-track {
  height: 1px;
  background: rgba(255, 255, 255, 0.26);
  border-radius: 999px;
}

.slider-shell input[type='range']::-moz-range-thumb {
  width: 16px;
  height: 16px;
  border: none;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08);
}

.slider-fill {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  height: 1px;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 999px;
}

.slider-handle {
  position: absolute;
  top: 50%;
  width: 16px;
  height: 16px;
  transform: translate(-50%, -50%);
  border-radius: 50%;
  background: #fff;
  box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08);
  pointer-events: none;
}

@media (max-width: 900px) {
  .app-shell {
    padding: 1rem 1rem 1.25rem;
  }

  .walk-stage {
    min-height: 440px;
    padding-bottom: 8rem;
  }

  .day-panel {
    position: static;
    width: 100%;
    margin-top: 1rem;
  }

  .stats-grid {
    grid-template-columns: 1fr;
  }

  .route-svg {
    inset: 14% 0 20% 0;
  }
}
